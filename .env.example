# Public URL used for TV QR check-in links (production default in lib/app-url.ts)
NEXT_PUBLIC_APP_URL=https://grapply.vercel.app

# Supabase / Postgres
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Strava OAuth V3
STRAVA_CLIENT_ID=your-strava-client-id
STRAVA_CLIENT_SECRET=your-strava-client-secret
STRAVA_REDIRECT_URI=http://localhost:3002/api/strava/callback

# GitHub PR -> Telegram updates webhook
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
